{
  "rules": {
    ".read": false,
    ".write": false,
    "labapp": {
      "presence": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.token.labUserId === $uid || auth.token.role === 'ADMIN')"
        }
      },
      "inventory": {
        ".read": false,
        ".write": false
      },
      "auth": {
        ".read": false,
        ".write": false
      },
      "settings": {
        ".read": false,
        ".write": false
      },
      "roster": {
        ".read": false,
        ".write": false
      },
      "liveChat": {
        ".read": false,
        ".write": false,
        ".indexOn": [
          "createdAt"
        ]
      },
      "systemLogs": {
        ".read": false,
        ".write": false
      }
    }
  }
}
