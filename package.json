{
  "name": "hoagpathology",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/blob": "2.4.0",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "desktop:dist": "electron-builder --win nsis --publish never",
    "test": "node --test tests/*.test.js",
    "audit": "node scripts/audit.mjs"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.hoagpathology.desktop",
    "productName": "Hoag Pathology",
    "artifactName": "Hoag-Pathology-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/main.cjs"
    ],
    "extraResources": [
      {
        "from": "desktop/config.json",
        "to": "desktop-config.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "installerHeaderIcon": "desktop/icon.ico"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
